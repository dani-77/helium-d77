# PAM configuration file for helium-locker (see /etc/pam.d/login for what
# "login" includes).
#
# helium-locker runs both stages, like Amorphis: `auth` checks the password
# and `account` rejects a locked or expired account (pam_acct_mgmt). The
# `account` line is needed for that: without it, what PAM does for the account
# stage depends on the distribution's fallback ("other") policy.
#
# Install to /etc/pam.d/helium-locker. Without this file helium-locker refuses
# to start rather than locking a session it could never unlock.

auth        include     login
account     include     login
