// Personal status bar built on top of the Helium shell framework.
// `bar_width` is set from src/main.rs at startup, derived from the actual
// monitor width — no need to hand-edit it for a different screen.

// One workspace pill's worth of state. Populated from the compositor's
// actual live workspace list (Hyprland and Niri alike — both already come
// out of helium-wsl as the same Vec<Workspace>), so the bar shows exactly as
// many pills as exist instead of a hardcoded count.
export struct WorkspaceItem {
    id: int,
    label: string,
    active: bool,
    occupied: bool,
    urgent: bool,
}

component Divider inherits Rectangle {
    width: 1px;
    height: 22px;
    border-width: 1px;
    border-color: Theme.line;
}

// Same rule in every d77 shell: active > urgent > occupied > empty, with
// empty workspaces dimmed.
component WorkspacePill inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> occupied: false;
    in property <bool> urgent: false;
    callback clicked;

    width: 26px;
    height: 24px;
    background: active ? Theme.accent : urgent ? Theme.danger : Theme.bg_high;
    border-width: 1px;
    border-color: active ? Theme.accent : urgent ? Theme.danger : Theme.line;
    opacity: !active && !urgent && !occupied ? 0.4 : 1;

    Text {
        text: label;
        color: active || urgent ? Theme.bg_dark : Theme.fg_dim;
        font-size: 11px;
        font-family: "Space Mono";
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component StatChip inherits Rectangle {
    in property <string> icon: "";
    in property <string> value: "";
    in property <bool> highlight: false;

    HorizontalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: icon;
            color: highlight ? Theme.accent : Theme.fg_muted;
            font-size: 13px;
            font-family: "Symbols Nerd Font";
            vertical-alignment: center;
        }

        Text {
            text: value;
            color: highlight ? Theme.fg : Theme.fg_muted;
            font-size: 12px;
            font-family: "Space Grotesk";
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component Bar inherits Window {
    in property <length> bar_width: 1346px;
    width: bar_width;
    height: 36px;
    background: transparent;

    in property <[WorkspaceItem]> workspaces: [];

    in property <string> net_icon: "\u{F092D}";
    in property <string> net_text: "…";
    in property <bool> net_connected: false;
    in property <string> cpu_text: "…";
    in property <string> ram_text: "…";
    in property <string> bat_text: "…";
    in property <bool> bat_charging: false;
    in property <bool> bat_present: false;
    in property <string> vol_text: "…";
    in property <bool> vol_muted: false;
    in property <string> clock_text: "";
    in property <string> weather_text: "…";

    callback workspace_clicked(int);
    callback launcher_clicked();
    callback session_clicked();
    callback network_clicked();
    callback cpu_clicked();
    callback memory_clicked();
    callback volume_clicked();
    callback battery_clicked();

    Rectangle {
        background: Theme.bg;
        border-radius: self.height / 2;
        clip: true;

        // --- Workspaces (pinned left) ---------------------------------------
        Rectangle {
            x: 0;
            width: 256px;
            height: 100%;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                Rectangle {
                    width: 20px;

                    Text {
                        text: "\u{F009}";
                        color: Theme.fg_dim;
                        font-size: 14px;
                        font-family: "Symbols Nerd Font";
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    TouchArea { clicked => { launcher_clicked(); } }
                }

                for ws in workspaces : WorkspacePill {
                    label: ws.label;
                    active: ws.active;
                    occupied: ws.occupied;
                    urgent: ws.urgent;
                    clicked => { workspace_clicked(ws.id); }
                }
            }
        }

        // --- Weather + date/time — geometrically centered on the whole bar
        // as one unit, not on whatever space happens to be left between the
        // other two groups. ---
        Rectangle {
            x: (parent.width - self.width) / 2;
            width: 320px;
            height: 100%;

            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "\u{F0C2}";
                    color: Theme.fg_dim;
                    font-size: 13px;
                    font-family: "Symbols Nerd Font";
                    vertical-alignment: center;
                }

                Text {
                    text: weather_text;
                    color: Theme.fg_dim;
                    font-size: 12px;
                    font-family: "Space Grotesk";
                    vertical-alignment: center;
                }

                Divider { }

                Text {
                    text: "\u{F017}";
                    color: Theme.accent;
                    font-size: 13px;
                    font-family: "Symbols Nerd Font";
                    vertical-alignment: center;
                }

                Text {
                    text: clock_text;
                    color: Theme.accent;
                    font-size: 13px;
                    font-family: "Space Mono";
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }

        // --- Network / CPU / RAM / battery / volume / session (pinned right) --
        Rectangle {
            x: parent.width - self.width;
            // As wide as its contents: a fixed 494px stopped fitting once
            // the battery chip grew to 110px, and the session button, last
            // in the row, was clipped off the bar.
            width: right_row.preferred-width;
            height: 100%;

            right_row := HorizontalLayout {
                padding: 0;
                spacing: 0;

                StatChip {
                    width: 190px;
                    icon: net_icon;
                    value: net_text;
                    highlight: net_connected;
                    TouchArea { clicked => { network_clicked(); } }
                }
                Divider { }
                StatChip {
                    width: 64px; icon: "\u{F2DB}"; value: cpu_text; highlight: true;
                    TouchArea { clicked => { cpu_clicked(); } }
                }
                Divider { }
                StatChip {
                    width: 64px; icon: "\u{F0A0}"; value: ram_text; highlight: true;
                    TouchArea { clicked => { memory_clicked(); } }
                }
                Divider { }
                bat_chip := StatChip {
                    // Hidden on a battery-less desktop instead of showing a
                    // stale/fake reading — see `bat_present` in main.rs.
                    visible: bat_present;
                    // Wider than the other 64px chips: bat_text carries the
                    // time estimate too now, e.g. "36% (1h54m)" — a hover
                    // tooltip (PopupWindow) was tried first, but it doesn't
                    // compose with this bar's wlr-layer-shell surface: its
                    // `y` positions relative to the output, not the bar, so
                    // it rendered overlapping the bar instead of below it.
                    // The lower-level layer-shika crate has a real
                    // Wayland-positioned popup API, but it isn't exposed by
                    // the helium-wsl ShellInstance wrapper main.rs otherwise
                    // relies on for everything — reaching it means giving up
                    // that wrapper entirely, too big a rewrite for a
                    // tooltip. Showing the time inline sidesteps the whole
                    // problem, at the cost of always taking up the room
                    // instead of only on hover.
                    width: 110px;
                    icon: bat_charging ? "\u{F0E7}" : "\u{F240}";
                    value: bat_text;
                    highlight: true;
                    TouchArea { clicked => { battery_clicked(); } }
                }
                Divider { visible: bat_present; }
                StatChip {
                    width: 72px;
                    icon: vol_muted ? "\u{F026}" : "\u{F028}";
                    value: vol_text;
                    highlight: !vol_muted;
                    TouchArea { clicked => { volume_clicked(); } }
                }
                Divider { }

                Rectangle {
                    width: 40px;

                    Text {
                        text: "\u{F011}";
                        color: Theme.fg_dim;
                        font-size: 14px;
                        font-family: "Symbols Nerd Font";
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    TouchArea { clicked => { session_clicked(); } }
                }
            }
        }
    }
}
