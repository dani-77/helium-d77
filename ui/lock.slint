// Lock screen for helium-locker. Only ever shown on ext-session-lock-v1
// surfaces while the compositor holds the session lock — there is no window
// chrome and no way to dismiss it besides a correct password.
//
// This component is purely presentational. Keyboard input never reaches
// Slint: helium-locker reads keys itself into an mlock'ed, wiped-on-drop
// password buffer (src/lock/secret.rs) and only tells this view how many
// characters were typed. The password text itself never exists as a Slint
// string. One instance is created per output and they are all kept in sync.
//
// Palette matches ui/bar.slint: #141414/#0d0d0d backgrounds, #76b900 accent,
// "Space Grotesk"/"Space Mono" body fonts, "Symbols Nerd Font" icons.

export component LockScreen inherits Window {
    background: #0d0d0d;

    // All set from Rust.
    in property <string> clock_text: "";
    in property <string> date_text: "";
    in property <int> password_length: 0;
    in property <bool> show_error: false;
    in property <bool> checking: false;
    in property <bool> caps_lock: false;

    // Cap the dots so a long password can't overflow the field.
    property <int> max_dots: 20;

    VerticalLayout {
        alignment: center;
        // Default cross-axis-alignment is Stretch, which left-anchors any
        // cell that isn't full-width (like the fixed-320px password box
        // below) instead of centering it under the clock/date.
        cross-axis-alignment: center;
        spacing: 18px;

        Text {
            text: "\u{F023}";
            color: #76b900;
            font-size: 40px;
            font-family: "Symbols Nerd Font";
            horizontal-alignment: center;
        }

        Text {
            text: root.clock_text;
            color: #d4d4d4;
            font-size: 64px;
            font-family: "Space Mono";
            letter-spacing: 2px;
            horizontal-alignment: center;
        }

        Text {
            text: root.date_text;
            color: #888;
            font-size: 16px;
            font-family: "Space Grotesk";
            horizontal-alignment: center;
        }

        Rectangle { height: 16px; }

        Rectangle {
            width: 320px;
            height: 48px;
            background: #141414;
            border-radius: 10px;
            border-width: 2px;
            border-color: root.show_error ? #d95c5c : (root.checking ? #888 : #76b900);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;

                Text {
                    text: "\u{F084}";
                    color: #76b900;
                    font-size: 15px;
                    font-family: "Symbols Nerd Font";
                    vertical-alignment: center;
                }

                if root.password_length == 0: Text {
                    text: "Password";
                    color: #555;
                    font-size: 15px;
                    font-family: "Space Grotesk";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                if root.password_length > 0: HorizontalLayout {
                    alignment: start;
                    spacing: 6px;
                    horizontal-stretch: 1;

                    for i in min(root.password_length, root.max_dots): VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: #d4d4d4;
                        }
                    }
                }
            }
        }

        Text {
            text: root.checking
                ? "Checking…"
                : root.show_error
                    ? "Incorrect password"
                    : root.caps_lock ? "Caps Lock is on" : "";
            color: root.show_error ? #d95c5c : (root.caps_lock && !root.checking ? #e0b050 : #888);
            font-size: 12px;
            font-family: "Space Grotesk";
            horizontal-alignment: center;
        }
    }
}
