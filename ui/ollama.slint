// Chat popup for a locally running Ollama daemon (http://127.0.0.1:11434),
// mirroring quickshell-d77/utumno's OllamaChat.qml. Driven entirely from
// src/bin/helium-ollama.rs: it shells out to `curl` for status/model-list
// polling and for the streaming pull/generate requests, then pushes the
// results back onto this component's properties.
//
// Palette matches ui/bar.slint / ui/osd.slint: #0d0d0d/#141414 backgrounds,
// #76b900 accent, "Space Grotesk"/"Space Mono" body fonts, "Symbols Nerd
// Font" icons (only the header status dot / chevrons use plain glyphs
// here, no icon font needed for those).

export component Ollama inherits Window {
    width: 560px;
    height: 620px;
    background: transparent;

    // --- Driven from Rust ---------------------------------------------
    in property <bool> ollama_up: false;
    in property <string> current_model: "";
    in property <[string]> model_names: [];
    in property <int> model_count: 0;
    in property <length> dropdown_height: 0px;
    in property <string> info_text: "";
    in property <string> history_text: "";
    in property <string> hardware_hint: "";
    in property <bool> auto_pull_active: false;

    // --- Local UI-only state (never touched from Rust) ----------------
    property <bool> dropdown_open: false;
    property <bool> install_visible: false;

    // --- Out to Rust ----------------------------------------------------
    callback model_selected(string);
    callback install_submitted(string);
    callback prompt_submitted(string);
    callback auto_pull_cancel();
    callback close_requested();
    // (text, selection-anchor-byte-offset, cursor-byte-offset) — see the
    // key-pressed handler on `history_text_item` below for why Ctrl+C needs
    // its own round-trip to Rust instead of `TextInput`'s built-in copy.
    callback copy_requested(string, int, int);

    forward-focus: prompt_input;

    changed model_count => {
        // The list can shrink/refresh under an open dropdown (a 15s refresh
        // tick landing while it's open); closing it rather than leaving a
        // stale row count on screen keeps this simple.
        dropdown_open = false;
    }

    Rectangle {
        background: #0d0d0d;
        border-radius: 14px;
        clip: true;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            // --- Header ---------------------------------------------------
            HorizontalLayout {
                height: 30px;
                spacing: 8px;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    y: (parent.height - self.height) / 2;
                    background: ollama_up ? #76b900 : #f7768e;
                }

                Text {
                    text: "Ollama";
                    color: #d4d4d4;
                    font-size: 16px;
                    font-weight: 700;
                    font-family: "Space Grotesk";
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: 200px;
                    height: 30px;
                    border-radius: 6px;
                    background: #1a1a1a;
                    border-width: 1px;
                    border-color: dropdown_open ? #76b900 : #333;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 6px;

                        Text {
                            text: current_model;
                            color: #d4d4d4;
                            font-size: 12px;
                            font-family: "Space Grotesk";
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        Text {
                            text: dropdown_open ? "▲" : "▼";
                            color: #999;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => { dropdown_open = !dropdown_open; }
                    }
                }
            }

            // --- Model dropdown --------------------------------------------
            Rectangle {
                visible: dropdown_open;
                height: dropdown_open ? dropdown_height : 0px;
                border-radius: 8px;
                background: #1a1a1a;
                border-width: 1px;
                border-color: #333;
                clip: true;

                Flickable {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    viewport-width: self.width;
                    viewport-height: (model_count + 1) * 28px;

                    VerticalLayout {
                        for name in model_names : Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: model_ta.has-hover ? #1f3319 : transparent;

                            Text {
                                x: 8px;
                                text: name;
                                color: #d4d4d4;
                                font-size: 12px;
                                font-family: "Space Grotesk";
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            model_ta := TouchArea {
                                clicked => {
                                    dropdown_open = false;
                                    model_selected(name);
                                }
                            }
                        }

                        Rectangle {
                            height: 28px;
                            border-radius: 6px;
                            background: install_ta.has-hover ? #16232b : transparent;

                            Text {
                                x: 8px;
                                text: "+ instalar novo modelo...";
                                color: #7dcfff;
                                font-size: 12px;
                                font-family: "Space Grotesk";
                                vertical-alignment: center;
                            }

                            install_ta := TouchArea {
                                clicked => {
                                    dropdown_open = false;
                                    install_visible = true;
                                    install_input.focus();
                                }
                            }
                        }
                    }
                }
            }

            // --- Install new model field ------------------------------------
            Rectangle {
                visible: install_visible;
                height: install_visible ? 36px : 0px;
                border-radius: 8px;
                background: #1a1a1a;
                border-width: 1px;
                border-color: install_input.has-focus ? #76b900 : #333;
                clip: true;

                install_input := TextInput {
                    x: 10px;
                    width: parent.width - 20px;
                    color: #d4d4d4;
                    font-size: 13px;
                    font-family: "Space Grotesk";
                    vertical-alignment: center;
                    single-line: true;

                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == "\u{000d}") {
                            install_visible = false;
                            if (self.text != "") {
                                install_submitted(self.text);
                            }
                            self.text = "";
                            prompt_input.focus();
                            accept
                        } else if (event.text == Key.Escape) {
                            install_visible = false;
                            self.text = "";
                            prompt_input.focus();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                Text {
                    x: 10px;
                    visible: install_input.text == "";
                    text: "nome-do-modelo:tag (ex: llama3.2:3b)";
                    color: #666;
                    font-size: 13px;
                    font-family: "Space Grotesk";
                    vertical-alignment: center;
                }
            }

            // --- Hardware-based size suggestion, shown while the install
            // panel above is open --------------------------------------------
            Text {
                visible: install_visible && hardware_hint != "";
                text: hardware_hint;
                color: #666;
                font-size: 11px;
                font-family: "Space Grotesk";
                wrap: word-wrap;
            }

            // --- First-run automatic model download, cancellable --------------
            Rectangle {
                visible: auto_pull_active;
                height: auto_pull_active ? 56px : 0px;
                border-radius: 8px;
                background: #16230d;
                border-width: 1px;
                border-color: #76b900;
                clip: true;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;

                        Text {
                            text: "⬇ Primeira execução — a instalar modelo automaticamente";
                            color: #9ece6a;
                            font-size: 11px;
                            font-weight: 700;
                            font-family: "Space Grotesk";
                            overflow: elide;
                        }

                        Text {
                            text: info_text;
                            color: #d4d4d4;
                            font-size: 11px;
                            font-family: "Space Grotesk";
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 60px;
                        height: 26px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 6px;
                        background: stop_ta.has-hover ? #3a1414 : #241414;
                        border-width: 1px;
                        border-color: #f7768e;

                        Text {
                            text: "Parar";
                            color: #f7768e;
                            font-size: 11px;
                            font-family: "Space Grotesk";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        stop_ta := TouchArea {
                            clicked => { auto_pull_cancel(); }
                        }
                    }
                }
            }

            // --- Info / progress banner --------------------------------------
            Text {
                visible: info_text != "" && !auto_pull_active;
                text: info_text;
                color: #7aa2f7;
                font-size: 12px;
                font-family: "Space Grotesk";
                wrap: word-wrap;
            }

            // --- History ------------------------------------------------------
            Rectangle {
                vertical-stretch: 1;
                border-radius: 8px;
                background: #141414;
                border-width: 1px;
                border-color: #333;
                clip: true;

                history_flick := Flickable {
                    x: 10px;
                    y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    viewport-width: self.width;
                    viewport-height: max(self.height, history_measure.preferred-height);

                    // Keeps the newest output in view as the model streams.
                    changed viewport-height => {
                        history_flick.viewport-y = min(0px, history_flick.height - history_flick.viewport-height);
                    }

                    // Invisible twin of `history_text_item` below, kept only because
                    // `TextInput` (unlike `Text`) has no content-based `preferred-height`
                    // of its own to size the viewport from — it defaults to filling
                    // whatever height it's given instead of wrapping to fit its text.
                    history_measure := Text {
                        visible: false;
                        width: parent.width;
                        text: history_text;
                        font-size: 13px;
                        font-family: "Space Mono";
                        wrap: word-wrap;
                    }

                    // `TextInput` instead of `Text` so the AI's output can actually be
                    // selected (mouse drag) and copied (Ctrl+C) out of the window —
                    // `read-only: true` keeps it from being edited or grabbing normal
                    // typing away from `prompt_input`.
                    history_text_item := TextInput {
                        width: parent.width;
                        height: history_measure.preferred-height;
                        text: history_text;
                        read-only: true;
                        single-line: false;
                        color: #d4d4d4;
                        selection-background-color: #76b90066;
                        selection-foreground-color: #ffffff;
                        font-size: 13px;
                        font-family: "Space Mono";
                        wrap: word-wrap;

                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                close_requested();
                                accept
                            // Ctrl held + "c" arrives here as the raw ETX control character
                            // (`\u{3}`), not the letter "c" -- checking for the letter too
                            // costs nothing and keeps this working if that ever differs.
                            } else if (event.modifiers.control && (event.text == "c" || event.text == "C" || event.text == "\u{3}")) {
                                copy_requested(
                                    self.text,
                                    self.anchor-position-byte-offset,
                                    self.cursor-position_byte-offset,
                                );
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }
            }

            // --- Prompt field ---------------------------------------------------
            Rectangle {
                height: 40px;
                border-radius: 8px;
                background: #1a1a1a;
                border-width: 1px;
                border-color: prompt_input.has-focus ? #76b900 : #333;

                prompt_input := TextInput {
                    x: 12px;
                    width: parent.width - 24px;
                    color: #d4d4d4;
                    font-size: 13px;
                    font-family: "Space Grotesk";
                    vertical-alignment: center;
                    single-line: true;

                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == "\u{000d}") {
                            if (self.text != "") {
                                prompt_submitted(self.text);
                                self.text = "";
                            }
                            accept
                        } else if (event.text == Key.Escape) {
                            close_requested();
                            accept
                        } else {
                            reject
                        }
                    }
                }

                Text {
                    x: 12px;
                    visible: prompt_input.text == "";
                    text: "Pergunta à IA...";
                    color: #666;
                    font-size: 13px;
                    font-family: "Space Grotesk";
                    vertical-alignment: center;
                }
            }
        }
    }
}
